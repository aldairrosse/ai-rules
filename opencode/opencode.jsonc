{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "engram": {
      "command": [
        "/home/frankil_aldair/.local/bin/engram",
        "mcp",
        "--tools=agent"
      ],
      "enabled": true,
      "type": "local"
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "maestro": {
       "enabled": true,
       "type": "local",
       "command": ["maestro", "mcp"]
    }
  },
  "plugin": [
    "@dietrichgebert/ponytail"
  ]
}
